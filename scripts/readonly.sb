; macOS Seatbelt profile for the official CLI and any children.
(version 1)
(allow default)
(deny file-write*)
; Only the private per-invocation runtime is writable, including for CLI logs.
; The workspace snapshots and the user's existing agy state are read-only.
(allow file-write* (subpath (param "RUN")) (literal "/dev/null"))
(deny process-exec*)
; agy uses the macOS credential helper for its normal subscription sign-in.
(allow process-exec (literal (param "AGY")) (literal "/usr/bin/security"))
